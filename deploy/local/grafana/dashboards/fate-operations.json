{
  "annotations":{"list":[]},"editable":false,"schemaVersion":41,"tags":["fate","operations"],"title":"FATE operations","uid":"fate-operations","version":1,"refresh":"10s","time":{"from":"now-6h","to":"now"},"templating":{"list":[]},
