    {"id":3,"type":"stat","title":"Finalized slot lag","gridPos":{"x":12,"y":0,"w":6,"h":6},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"fate:indexer_lag:max","refId":"A"}]},
