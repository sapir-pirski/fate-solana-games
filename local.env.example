# Local development only. Never copy production credentials into this file.
COMPOSE_PROJECT_NAME=fate-local
FATE_LOCAL_PORT=3100
POSTGRES_PORT=55432
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3101
TEMPO_PORT=3200

POSTGRES_DB=fate
POSTGRES_USER=fate_app
POSTGRES_PASSWORD=replace-with-a-local-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-password
INDEXER_AUTH_TOKEN=replace-with-a-local-random-token

NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_URLS=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
# Optional but recommended: pin the expected cluster genesis hash.
SOLANA_GENESIS_HASH=
INDEXER_POLL_MS=15000
INDEXER_MAX_BACKFILL_PAGES=100
INDEXER_HEALTH_PORT=9464
NEXT_PUBLIC_FATE_PROGRAM_ID=Fg6PaFpoGXkYsidMpWxqSWY4vF8zqRkMnJx9QpMvdWvZ
FATE_PROGRAM_ID=Fg6PaFpoGXkYsidMpWxqSWY4vF8zqRkMnJx9QpMvdWvZ

# Leave empty to disable provider-backed AI locally, or use the optional Ollama
# profile through a compatible gateway added later.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
AI_MAX_REQUESTS_PER_WALLET_DAY=50
AI_MAX_TOKENS_PER_WALLET_DAY=100000
AI_PROVIDER_TIMEOUT_MS=30000
AI_MONTHLY_BUDGET_USD=5
AI_INPUT_USD_PER_MILLION_TOKENS=1.25
AI_OUTPUT_USD_PER_MILLION_TOKENS=10
COMPLIANCE_ALLOWED_COUNTRIES=
COMPLIANCE_BLOCKED_COUNTRIES=
