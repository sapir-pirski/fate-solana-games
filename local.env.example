# Local development only. Never copy production credentials into this file.
COMPOSE_PROJECT_NAME=fate-local
FATE_LOCAL_PORT=3100
POSTGRES_PORT=55432
REDIS_PORT=56379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3101

POSTGRES_DB=fate
POSTGRES_USER=fate_app
POSTGRES_PASSWORD=replace-with-a-local-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-password
INDEXER_AUTH_TOKEN=replace-with-a-local-random-token

NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_FATE_PROGRAM_ID=Fg6PaFpoGXkYsidMpWxqSWY4vF8zqRkMnJx9QpMvdWvZ
FATE_PROGRAM_ID=Fg6PaFpoGXkYsidMpWxqSWY4vF8zqRkMnJx9QpMvdWvZ

# Leave empty to disable provider-backed AI locally, or use the optional Ollama
# profile through a compatible gateway added later.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
AI_MAX_REQUESTS_PER_WALLET_DAY=50
AI_MONTHLY_BUDGET_USD=5
AI_AGENT_ARENA_ENABLED=false
AI_AGENT_ARENA_NETWORK=devnet
