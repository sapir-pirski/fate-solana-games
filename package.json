{
  "name": "fate-solana-games",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "node --test tests/integration/*.integration.mjs",
    "test:browser": "playwright test tests/browser/platform.spec.ts",
    "test:accessibility": "playwright test tests/browser/accessibility.spec.ts",
    "test:contract": "playwright test tests/browser/contracts.spec.ts --project=chromium",
    "test:load": "docker run --rm -i -e BASE_URL=${BASE_URL:-http://host.docker.internal:3100} grafana/k6:latest run - < tests/load/platform.k6.js",
    "test:failure": "bash tests/failure/run-recovery.sh",
    "test:all": "npm test && npm run test:unit && npm run test:integration && npm run test:contract && npm run test:browser",
    "test:devnet": "node scripts/devnet-smoke.mjs",
    "test:acceptance": "node scripts/devnet-acceptance.mjs",
    "test:production": "node scripts/production-smoke.mjs",
    "test:bundle": "npm run build && node scripts/check-bundle-budget.mjs",
    "security:audit": "npm audit --audit-level=low",
    "security:sbom": "cyclonedx-npm --package-lock-only --omit dev --output-reproducible --validate --output-format JSON --output-file -",
    "security:authorities": "node scripts/verify-authority-separation.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:restore": "node scripts/restore-backup.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "@solana/wallet-standard-features": "^1.4.0",
    "@solana/web3.js": "^1.98.4",
    "@wallet-standard/app": "^1.1.1",
    "@wallet-standard/base": "^1.1.1",
    "@wallet-standard/features": "^1.1.1",
    "buffer": "6.0.3",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "openai": "^7.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "wrangler": "^4.118.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "^1.50.0",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@cyclonedx/cyclonedx-npm": "^6.0.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.2.0"
  },
  "type": "module",
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "uuid": "14.0.1"
  }
}
