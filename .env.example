# Keep devnet as the default until the program has completed audit and launch review.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional comma-separated fallback endpoints used for confirmation recovery.
NEXT_PUBLIC_SOLANA_RPC_URLS=https://api.devnet.solana.com
NEXT_PUBLIC_FATE_PROGRAM_ID=Fg6PaFpoGXkYsidMpWxqSWY4vF8zqRkMnJx9QpMvdWvZ
# Coinflip joins require a fresh, committed Switchboard account. Prefer the endpoint;
# the static account is only suitable for a single local/devnet acceptance fixture.
NEXT_PUBLIC_COINFLIP_RANDOMNESS_ENDPOINT=
NEXT_PUBLIC_COINFLIP_RANDOMNESS_ACCOUNT=
# A provider endpoint must return {"randomnessAccount":"<fresh committed Switchboard account>"}.
# The static account option is intended only for a one-request local/devnet fixture.
NEXT_PUBLIC_DAILY_RANDOMNESS_ENDPOINT=
NEXT_PUBLIC_DAILY_RANDOMNESS_ACCOUNT=
NEXT_PUBLIC_SWITCHBOARD_PROGRAM_ID=Aio4gaXjXzJNVLtzwtNVmSqGKpANtXhybbkhtAC94ji2
# Set this to the exact Switchboard On-Demand queue selected for deployment.
NEXT_PUBLIC_SWITCHBOARD_QUEUE=
OTEL_SERVICE_NAME=fate-platform
# OTLP/HTTP base URL; leave blank to disable trace export without affecting gameplay.
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318

# Operations and automation secrets are server-only. Never prefix them with NEXT_PUBLIC_.
SOLANA_RPC_URL=https://api.devnet.solana.com
FATE_PROGRAM_ID=Fg6PaFpoGXkYsidMpWxqSWY4vF8zqRkMnJx9QpMvdWvZ
# Public role addresses only. Never store member keypairs or seed phrases here.
INDEXER_AUTH_TOKEN=replace-with-a-long-random-value
# Shared only by the hosting runtime and scheduled CI maintenance/backup jobs.
AUTOMATION_TOKEN=replace-with-a-different-long-random-value
# Restore accepts only versioned, checksum-verified backups within these limits.
RESTORE_MAX_BYTES=10485760
RESTORE_MAX_ROWS=10000
PRIVACY_REQUEST_DEADLINE_DAYS=30
PRIVACY_EXPORT_TTL_SECONDS=604800

# AI configuration. All provider credentials must remain server-only.
OPENAI_API_KEY=replace-with-your-openai-api-key

OPENAI_MODEL=replace-with-approved-model-name
AI_MAX_REQUESTS_PER_WALLET_DAY=50
AI_MAX_TOKENS_PER_WALLET_DAY=100000
AI_PROVIDER_TIMEOUT_MS=30000
AI_MONTHLY_BUDGET_USD=25
# Update these estimates when changing models; they are used for the hard monthly circuit breaker.
AI_INPUT_USD_PER_MILLION_TOKENS=1.25
AI_CACHED_INPUT_USD_PER_MILLION_TOKENS=0.125
AI_OUTPUT_USD_PER_MILLION_TOKENS=10

# Compliance policy is fail-closed on mainnet. ISO alpha-2 lists are comma-separated.
COMPLIANCE_ALLOWED_COUNTRIES=
COMPLIANCE_BLOCKED_COUNTRIES=
